window {
    size(180,152)

    binddata('redstone','rsMode','mcjtylib:base_be_data')

    panel('','positional') {
        bg1('resonantia:textures/gui/resonant_energy_gui.png')
        energybar('energybar') {
            hint(10,7,8,54)
            showtext(false)
        }
        imagechoicelabel('redstone') {
            hint(19,44,16,16)
            image('rftoolsbase:textures/gui/guielements.png')
            dim(32,0,256,256)
            choices {
                choice('Ignored') {
                    uv(0,0)
                    tooltips('Redstone mode:','Ignored')
                    image('rftoolsbase:textures/gui/guielements.png')
                }
                choice('Off') {
                    uv(16,0)
                    tooltips('Redstone mode:','Off to activate')
                    image('rftoolsbase:textures/gui/guielements.png')
                }
                choice('On') {
                    uv(32,0)
                    tooltips('Redstone mode:','On to activate')
                    image('rftoolsbase:textures/gui/guielements.png')
                }
            }
        }
    }
}